{
  "name": "@macromackie/isocache-engine",
  "version": "0.1.0",
  "description": "Postgres transactions and client-view synchronization for offline applications",
  "homepage": "https://github.com/macromackie/isocache-engine#readme",
  "bugs": {
    "url": "https://github.com/macromackie/isocache-engine/issues"
  },
  "license": "MIT",
  "author": "Scott Mackie",
  "repository": {
    "type": "git",
    "url": "https://github.com/macromackie/isocache-engine.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "example:migrate": "tsx examples/migrate.ts",
    "example:dev": "wrangler dev --config examples/wrangler.jsonc --port 8799",
    "example:celld": "celld dev examples/wrangler.jsonc --port 8799",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/node": "22.19.17",
    "@types/pg": "8.20.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
