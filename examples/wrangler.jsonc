{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "isocache-example",
  "main": "worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DATABASE_URL": "postgres://example:example@127.0.0.1:55449/example",
    "DEMO_PRINCIPAL": "example-user",
    "BUILD_ID": "example",
  },
}
